{
  "name": "hand-made-agent",
  "private": true,
  "license": "MIT",
  "repository": "github:skgc45/hand-made-agent",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "serve": "node --env-file-if-exists=.env --import tsx src/serve.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@ag-ui/encoder": "^0.0.59",
    "openai": "^7.10.0"
  },
  "bin": {
    "hma": "./bin/hma.js"
  }
}
